# ===================================================================
# PetFinder / docXaOs - Environment Configuration Template
# Copy this file to .env and adjust variables as necessary:
#   cp .env.example .env
# ===================================================================

# Telegram Bot API Token (Get one from https://t.me/BotFather)
TELEGRAM_API_TOKEN=your_telegram_bot_token_here

# Flask Application Secret Key (Used for secure session signing)
# Generate one using: python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=replace_with_a_secure_random_secret_key

# Environment Mode: 'development' | 'testing' | 'production'
FLASK_ENV=development

# Server Network Settings
SERVER_HOST=0.0.0.0
API_PORT=5000
FRONTEND_PORT=8080

# SQLite Database File
DB_NAME=petfinder.db

# Open API KhMAO Integration Endpoint
ANIMAL_API_BASE_URL=https://animals.admhmao.ru/pets-api/open
API_TIMEOUT=10

# Media Uploads & ML Parameters
UPLOAD_FOLDER=static/uploads
SIMILARITY_THRESHOLD=0.7
SESSION_LIFETIME=30

# Logging
LOGGING_LEVEL=INFO
LOGGING_FILE=petfinder.log
